{
  "name": "@vishine/knowledge-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "tsx tools/generate.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "validate": "tsx tools/validate.ts",
    "build": "npm run generate && npm run typecheck && vite build",
    "check": "npm run generate && npm run typecheck && npm run format:check && npm test && npm run validate -- examples",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"tools/*.ts\" \"tests/*.ts\"",
    "validate:html": "tsx tools/validate-html.ts"
  },
  "dependencies": {
    "echarts": "6.1.0",
    "katex": "0.19.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/katex": "0.16.8",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "ajv": "8.20.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "yaml": "2.9.1"
  }
}
